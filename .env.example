# 心知天气 API Key（私钥）
# 请在 https://www.seniverse.com/ 注册获取
SENIVERSE_API_KEY=your_private_key_here

# 查询的城市（可以是城市名称、城市ID或经纬度）
CITY=beijing

# 飞书机器人 Webhook 地址
# 在飞书群中添加自定义机器人，获取 Webhook URL
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# HTML 报告访问 URL
# 本地开发：file:///path/to/index.html
# GitHub Pages：https://your-username.github.io/your-repo-name/
REPORT_URL=https://your-username.github.io/weather-alert-bot/
